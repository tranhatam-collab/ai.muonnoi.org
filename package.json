{
  "name": "ai-muonnoi-org",
  "version": "0.1.0",
  "private": true,
  "description": "ai.muonnoi.org public beta with static social feed, docs, and Cloudflare Worker API",
  "type": "module",
  "scripts": {
    "serve": "python3 -m http.server 8080",
    "check:json": "node -e \"JSON.parse(require('fs').readFileSync('./data/feed.json','utf8')); console.log('feed.json OK')\"",
    "check:wrangler": "node -e \"JSON.parse(require('fs').readFileSync('./wrangler.json','utf8')); console.log('wrangler.json OK')\"",
    "check:operations": "node tools/check-operations.mjs",
    "check": "npm run check:json && npm run check:wrangler && npm run check:operations",
    "lint": "echo \"No root lint task is configured for the static public shell\"",
    "build": "node tools/build.mjs",
    "build:api": "node tools/bundle-api.mjs",
    "dev:studio": "node tools/bundle-api.mjs && node tools/studio-preview.mjs",
    "dev:intake": "node tools/build.mjs && node tools/intake-preview.mjs",
    "dev:revenueops": "npm --prefix workers/revenueops run dev",
    "test:publishing": "node tools/bundle-api.mjs && node --test tests/publishing.test.mjs",
    "test:payment-email-security": "node tools/bundle-payment-email-security.mjs && node --test tests/payment-email-security.test.mjs",
    "test:payment-email-workerd": "node tools/bundle-api.mjs && node --test tests/payment-email-workerd.mjs",
    "test:intake:worker": "node tools/bundle-api.mjs && node --test tests/intake-workerd.mjs",
    "test:intake:ui": "node tools/bundle-api.mjs && node --test tests/intake-ui.test.mjs tests/intake-numeric-identity.test.mjs",
    "test:static": "node --test tests/static.test.mjs tests/login-redirect.test.mjs",
    "verify": "npm run check && npm run typecheck:api && npm run test:publishing && npm run test:payment-email-security && npm run test:payment-email-workerd && npm run test:publishing:worker && npm run test:intake:worker && npm run test:intake:ui && npm run test:intake:actions && npm run test:intake:triage && npm run test:intake:staging && npm run test:pilot:delivery && npm run test:commercial && npm run test:pilot:handoff && npm run build && npm run test:static && npm --prefix workers/revenueops run verify && npm --prefix workers/revenueops run typecheck && npm --prefix workers/revenueops run build && npm --prefix workers/revenueops run test:worker",
    "typecheck:api": "workers/revenueops/node_modules/.bin/tsc -p workers/api/tsconfig.json",
    "test:publishing:worker": "node --test tests/publishing-workerd.mjs",
    "test:intake:actions": "node --test tests/intake-actions.test.mjs",
    "test:intake:triage": "node tools/bundle-api.mjs && node --test tests/intake-triage-workerd.mjs",
    "test:intake:staging": "node --test tests/intake-staging.test.mjs",
    "prepare:intake:staging": "node tools/prepare-intake-staging.mjs",
    "prepare:pilot:delivery": "node tools/pilot-delivery.mjs",
    "test:pilot:delivery": "node --test tests/pilot-delivery.test.mjs",
    "test:commercial": "node --test tests/commercial-records.test.mjs",
    "rehearse:commercial": "node tools/rehearse-commercial.mjs",
    "test:pilot:handoff": "node --test tests/pilot-handoff.test.mjs",
    "verify:pilot:handoff": "node tools/pilot-handoff.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
