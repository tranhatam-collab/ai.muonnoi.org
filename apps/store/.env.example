# ---- Supabase (sổ cái đơn hàng + kho file ebook) ----
NEXT_PUBLIC_SUPABASE_URL=https://pyqonagrakxqjgnzaawf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Khóa service role: Supabase Dashboard > Project Settings > API Keys. Chỉ đặt trên server (Vercel env), không commit.
SUPABASE_SERVICE_ROLE_KEY=

# ---- payOS (VietQR, tiền về thẳng tài khoản ngân hàng của anh) ----
# Lấy tại my.payos.vn > Kênh thanh toán > Thông tin tích hợp
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# ---- PayPal (khách quốc tế, USD) ----
# developer.paypal.com > Apps & Credentials > Live > Create App
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=live   # hoặc sandbox khi thử

# ---- Giao sách ----
# Khóa ký link tải (chuỗi ngẫu nhiên dài >= 32 ký tự). Đổi khóa = mọi link cũ hết hạn.
DOWNLOAD_SECRET=
# Link tải có hiệu lực bao nhiêu giờ (mặc định 72)
DOWNLOAD_TTL_HOURS=72

# ---- Email (tùy chọn, có thể để trống: khách nhận sách ngay trên trang cảm ơn) ----
# Cách 1: Resend (resend.com, miễn phí 3.000 email/tháng)
RESEND_API_KEY=
# Cách 2: Gmail SMTP với App Password (myaccount.google.com/apppasswords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM="Sách Trần Hà Tâm <tranhatam@gmail.com>"

# ---- Chung ----
NEXT_PUBLIC_SITE_URL=https://sach-muonnoi.vercel.app
# Khóa bảo vệ các route quản trị (xác nhận webhook payOS, xem thống kê)
ADMIN_SECRET=
