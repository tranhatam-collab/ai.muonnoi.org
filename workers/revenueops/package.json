{
  "name": "ai-muonnoi-revenueops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node tools/dev.mjs",
    "check": "node tools/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "scenario": "node tools/scenario.mjs",
    "verify": "npm run check && npm test",
    "typecheck": "tsc --noEmit",
    "build": "node tools/build.mjs",
    "backup:local": "node tools/backup.mjs",
    "restore:drill": "node tools/restore-drill.mjs",
    "test:worker": "node --test tests/workerd.integration.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261015.1",
    "typescript": "7.0.2",
    "wrangler": "4.151.0",
    "miniflare": "5.20261012.0-beta"
  }
}
