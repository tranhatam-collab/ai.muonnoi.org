{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-muonnoi-revenueops-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "COORDINATOR", "class_name": "RevenueCoordinator" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RevenueCoordinator"] }],
  "triggers": { "crons": [] },
  "observability": { "enabled": false },
  "env": {
    "staging": {
      "name": "ai-muonnoi-revenueops-staging",
      "workers_dev": false,
      "preview_urls": false,
      "durable_objects": { "bindings": [{ "name": "COORDINATOR", "class_name": "RevenueCoordinator" }] },
      "triggers": { "crons": [] }
    },
    "production": {
      "name": "ai-muonnoi-revenueops-production",
      "workers_dev": false,
      "preview_urls": false,
      "durable_objects": { "bindings": [{ "name": "COORDINATOR", "class_name": "RevenueCoordinator" }] },
      "triggers": { "crons": [] }
    }
  }
}
